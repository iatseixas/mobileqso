{
  "name": "QSO Logbook",
  "short_name": "QSO Logbook",
  "description": "Logbook de radioamador com busca offline, databanks locais, frequências, repetidoras, rodadas e registro de QSOs.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
